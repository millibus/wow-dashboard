# Blizzard API OAuth credentials.
# Create an app at https://develop.battle.net/access/clients to get these.
# Used by both api/server.js (live VPS proxy) and scripts/build-snapshot.js
# (hourly GitHub Actions snapshot — set as repo secrets there too).
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# Express server port (live API on VPS). Optional; defaults to 3002.
PORT=3002

# Origins allowed to call /api/*, comma-separated. This server holds your
# Blizzard credentials, so keep the list to sites you actually run.
# Optional; defaults to the public dashboard plus localhost.
ALLOWED_ORIGINS=https://wow.nwpremier.net,http://localhost:3002

# Per-IP requests per minute against /api/*. Optional; defaults to 60.
RATE_LIMIT_PER_MIN=60

# Blizzard region, locale and per-request timeout. Optional; defaults shown.
BLIZZARD_REGION=us
BLIZZARD_LOCALE=en_US
BLIZZARD_TIMEOUT_MS=10000
